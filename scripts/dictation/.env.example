# Copy to .env and adjust. Falls back to these defaults if .env is absent.
DICTATION_WHISPER_MODEL=large-v3-turbo
DICTATION_WHISPER_DEVICE=cuda
DICTATION_HOTKEY=ctrl+alt+space
# Must match firmware/custom-voice-pe.yaml's claude_ptt_udp_port substitution.
DICTATION_UDP_PORT=6056
DICTATION_UDP_IDLE_TIMEOUT_S=2.0
