# Copy to .env and adjust. Falls back to these defaults if .env is absent.
DICTATION_WHISPER_MODEL=large-v3-turbo
DICTATION_WHISPER_DEVICE=cuda
DICTATION_HOTKEY=ctrl+alt+space
# Must match firmware/custom-voice-pe.yaml's claude_ptt_udp_port substitution.
DICTATION_UDP_PORT=6056
DICTATION_UDP_IDLE_TIMEOUT_S=2.0

# Direct (no-HA) ESPHome native API connection, used only to signal the ring's
# "processing" (yellow) state. noise_psk is a real secret -- pull the value HA
# already has (.storage/core.config_entries on the HA host, the esphome entry
# for this device's `data.noise_psk`) rather than generating a new one.
CLAUDE_PTT_ESPHOME_HOST=192.168.1.100
CLAUDE_PTT_ESPHOME_PORT=6053
CLAUDE_PTT_ESPHOME_NOISE_PSK=
